# Neon Cloud (team standard): rtm_db on the shared Neon instance.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<neon-host>/rtm_db?sslmode=require
# Local Docker fallback:
# DATABASE_URL=postgresql+psycopg2://rtm_user:rtm_password@localhost:5433/rtm_db
CORS_ORIGINS=http://localhost:5173

# Shared secret for Component 2's internal endpoints (must equal
# NEXTGENQA_INTERNAL_KEY in Intelligent-Test-Case-Generation/backend/.env).
# Lets the coverage feature fetch the open project's decrypted GitHub PAT to
# clone its connected repo. Leave empty to disable and rely on the env
# credentials below.
C2_INTERNAL_KEY=

# GitHub Code & Branch Coverage feature — never commit real values.
# GITHUB_TOKEN needs `repo` scope (read access) to check collaborator status
# and clone private repos; a fine-grained PAT with read-only contents+metadata
# works too as long as it can call /user, /repos/{owner}/{repo}, and
# /repos/{owner}/{repo}/collaborators/{username}.
GITHUB_USERNAME=
GITHUB_TOKEN=
# Optional: cap how long a clone+install+test run may take before it's killed.
COVERAGE_JOB_TIMEOUT_SECONDS=300
# Optional: force a specific JDK for Java (Maven/Gradle + JaCoCo) coverage
# runs, e.g. /opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home.
# Only needed if the backend host's default `java` is a version JaCoCo can't
# instrument and auto-detection (java_home -v 21/17/11, common install
# paths) doesn't find a working one on its own.
JAVA_HOME_FOR_COVERAGE=

# Component 2 (Intelligent-Test-Case-Generation) API base URL, used by the
# RTM Matrix / Test Inventory / Quality Prediction pages to pull generated
# test suites, execution runs, and risk predictions. Defaults to the local
# dev port Component 2 runs on if unset.
COMPONENT2_API_URL=http://localhost:8002/api/v1

# Component 1 (meeting-transcript -> requirements/user-stories) API base URL,
# used by the RTM Matrix page to pull GET /iterations/{id}/requirements-with-stories.
COMPONENT1_API_URL=http://localhost:8001
